rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===== 共通 =====
    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function validDisplayName(name) {
      return name is string && name.size() > 0 && name.size() <= 50;
    }

    function optionalString(v, max) {
      return v == null || (v is string && v.size() <= max);
    }

    function myUser() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // ===== users =====
    match /users/{uid} {
      allow read: if isSelf(uid);

      allow create: if isSelf(uid)
        && request.resource.data.keys().hasOnly(
             ['email', 'displayName', 'role', 'currentOfficeId', 'lang', 'createdAt', 'updatedAt'])
        && request.resource.data.keys().hasAll(
             ['email', 'displayName', 'role', 'currentOfficeId', 'lang', 'createdAt', 'updatedAt'])
        && request.resource.data.email == request.auth.token.email
        && validDisplayName(request.resource.data.displayName)
        && request.resource.data.role == 'admin'
        && request.resource.data.currentOfficeId == null
        && request.resource.data.lang in ['ja', 'en']
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      // 開いている事業所は「自分がメンバーの事業所」にしか切り替えられない
      // getAfter：同じ束の書き込みが終わった後の状態で確認する
      allow update: if isSelf(uid)
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['displayName', 'lang', 'currentOfficeId', 'updatedAt'])
        && validDisplayName(request.resource.data.displayName)
        && request.resource.data.lang in ['ja', 'en']
        && (request.resource.data.currentOfficeId == null
            || request.auth.uid in getAfter(
                 /databases/$(database)/documents/offices/$(request.resource.data.currentOfficeId)
               ).data.memberUids)
        && request.resource.data.updatedAt == request.time;

      allow delete: if false;
    }

    // ===== masterRates（料率マスタ：全事業所共通） =====
    match /masterRates/{rateId} {
      allow read: if signedIn();
      // アプリからは誰も書けない。書くのは投入スクリプト（Admin SDK）だけ
      allow write: if false;
    }

    // ===== masterGrades（標準報酬月額の等級表：全事業所共通） =====
    match /masterGrades/{gradeId} {
      allow read: if signedIn();
      allow write: if false;
    }

    // ===== employees 用 =====
    function isDate(v) {
      return v is string && v.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    function optionalDate(v) {
      return v == null || isDate(v);
    }

    function validName(v) {
      return v is string && v.size() > 0 && v.size() <= 50;
    }

    function validEnrollment(e) {
      return e.enrolled is bool
        && optionalDate(e.acquiredDate)
        && optionalDate(e.lostDate)
        && (!e.enrolled || e.acquiredDate != null);
    }

    function validEmployee(d) {
      return optionalString(d.employeeNumber, 20)
        && validName(d.lastName) && validName(d.firstName)
        && validName(d.lastNameKana) && validName(d.firstNameKana)
        && isDate(d.birthDate)
        && isDate(d.hireDate)
        && optionalDate(d.retireDate)
        && validEnrollment(d.health)
        && validEnrollment(d.pension)
        // 産休・育休：配列で20件まで。1件ずつの中身はアプリで確かめる（ルールに繰り返しがないため）
        && (!('leaves' in d) || (d.leaves is list && d.leaves.size() <= 20));
    }

    // ===== 料率 用 =====
    // 料率は 0.0001% を 1 とする整数。30% を上限にする
    function validRate(v) {
      return v is int && v >= 0 && v <= 300000;
    }

    function validSplit(s) {
      return s is map
        && s.keys().hasOnly(['employee', 'employer'])
        && s.keys().hasAll(['employee', 'employer'])
        && validRate(s.employee)
        && validRate(s.employer);
    }

    // ===== offices の設定と履歴 =====
    function validPayroll(p) {
      return p is map
        && p.keys().hasOnly(['closingDay', 'payDay', 'payMonth', 'deduction'])
        && p.keys().hasAll(['closingDay', 'payDay', 'payMonth', 'deduction'])
        && p.closingDay is int && p.closingDay >= 1 && p.closingDay <= 31
        && p.payDay is int && p.payDay >= 1 && p.payDay <= 31
        && p.payMonth in ['current', 'next']
        && p.deduction in ['current', 'next'];
    }

    function validPremiumSettings(p) {
      return p is map
        && p.keys().hasOnly(['method', 'healthRounding'])
        && p.keys().hasAll(['method', 'healthRounding'])
        && p.method in ['payroll', 'cash']
        && p.healthRounding in ['combined', 'separate'];
    }

    // ルールには繰り返しがないので、履歴の1行ずつは確かめられない。
    // 件数と「最新の行 ＝ 今の都道府県・保険者」を確かめる
    function validInsurerHistory(d) {
      return d.insurerHistory is list
        && d.insurerHistory.size() >= 1 && d.insurerHistory.size() <= 100
        && d.insurerHistory[d.insurerHistory.size() - 1].prefecture == d.prefecture
        && d.insurerHistory[d.insurerHistory.size() - 1].healthInsurer == d.healthInsurer;
    }

    // ===== offices =====
    function validOffice(d) {
      return d.name is string && d.name.size() > 0 && d.name.size() <= 100
        && optionalString(d.corporateName, 100)
        && (d.corporateNumber == null || (d.corporateNumber is string && d.corporateNumber.matches('^[0-9]{13}$')))
        && d.ownerName is string && d.ownerName.size() > 0 && d.ownerName.size() <= 50
        && (d.postalCode == null || (d.postalCode is string && d.postalCode.matches('^[0-9]{7}$')))
        && d.prefecture is string && d.prefecture.matches('^(0[1-9]|[1-3][0-9]|4[0-7])$')
        && d.address is string && d.address.size() > 0 && d.address.size() <= 200
        && ((d.healthInsurer.type == 'kyokai' && d.healthInsurer.kumiaiName == null)
            || (d.healthInsurer.type == 'kumiai' && d.healthInsurer.kumiaiName is string
                && d.healthInsurer.kumiaiName.size() > 0 && d.healthInsurer.kumiaiName.size() <= 100))
        && optionalString(d.officeSymbol, 20)
        && optionalString(d.officeNumber, 10)
        && (d.industry == null || (d.industry is string && d.industry.matches('^[A-T]$')))
        && (d.employeeCount == null || (d.employeeCount is int && d.employeeCount >= 0))
        && validPayroll(d.payroll)
        && validPremiumSettings(d.premium)
        && validInsurerHistory(d);
    }

    match /offices/{officeId} {
      // 読む：メンバーだけ（一覧の検索も、array-contains で自分に絞ったものだけ通る）
      allow read: if signedIn() && request.auth.uid in resource.data.memberUids;

      // 作る：事業所を作れるアカウントだけ。メンバーは自分1人・権限は admin で始める
      allow create: if signedIn()
        && myUser().role == 'admin'
        && request.resource.data.keys().hasOnly([
             'name', 'corporateName', 'corporateNumber', 'ownerName', 'postalCode', 'prefecture',
             'address', 'healthInsurer', 'officeSymbol', 'officeNumber', 'industry', 'employeeCount',
             'insurerHistory', 'payroll', 'premium',
             'memberUids', 'memberRoles', 'createdAt', 'updatedAt'])
        && request.resource.data.memberUids == [request.auth.uid]
        && request.resource.data.memberRoles.keys().hasOnly([request.auth.uid])
        && request.resource.data.memberRoles[request.auth.uid] == 'admin'
        && validOffice(request.resource.data)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      // 更新：その事業所の admin だけ。メンバーと作成日時は変えられない
      allow update: if signedIn()
        && resource.data.memberRoles[request.auth.uid] == 'admin'
        && !request.resource.data.diff(resource.data).affectedKeys()
              .hasAny(['memberUids', 'memberRoles', 'createdAt'])
        && validOffice(request.resource.data)
        && request.resource.data.updatedAt == request.time;

      allow delete: if false;
      // ----- 従業員（事業所の下） -----
      match /employees/{employeeId} {
        function office() {
          return get(/databases/$(database)/documents/offices/$(officeId)).data;
        }

        // 読む：その事業所のメンバー（管理者・一般）
        allow read: if signedIn() && request.auth.uid in office().memberUids;

        // 作る・更新する：その事業所の管理者だけ
        allow create: if signedIn()
          && office().memberRoles[request.auth.uid] == 'admin'
          && request.resource.data.keys().hasOnly([
               'employeeNumber', 'lastName', 'firstName', 'lastNameKana', 'firstNameKana',
               'birthDate', 'hireDate', 'retireDate', 'health', 'pension',
               'leaves', 'createdAt', 'updatedAt'])
          && validEmployee(request.resource.data)
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time;

        allow update: if signedIn()
          && office().memberRoles[request.auth.uid] == 'admin'
          && request.resource.data.keys().hasOnly([
               'employeeNumber', 'lastName', 'firstName', 'lastNameKana', 'firstNameKana',
               'birthDate', 'hireDate', 'retireDate', 'health', 'pension',
               'leaves', 'createdAt', 'updatedAt'])
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['createdAt'])
          && validEmployee(request.resource.data)
          && request.resource.data.updatedAt == request.time;

        // 削除：しない（退職は退職日で表す）
        allow delete: if false;

                // ----- 標準報酬月額の履歴（従業員の下。ドキュメントIDは適用開始月） -----
        match /remunerations/{remMonth} {
          function validStandard(s) {
            return s is map
              && s.keys().hasOnly(['grade', 'standard'])
              && s.keys().hasAll(['grade', 'standard'])
              && s.grade is int && s.grade >= 1 && s.grade <= 60
              && s.standard is int && s.standard > 0;
          }

          function validRemuneration(d) {
            return d.keys().hasOnly(['from', 'reason', 'monthlyAmount', 'health', 'pension', 'createdAt', 'updatedAt'])
              && d.keys().hasAll(['from', 'reason', 'monthlyAmount', 'health', 'pension', 'createdAt', 'updatedAt'])
              && d.from == remMonth
              && remMonth.matches('^[0-9]{4}-(0[1-9]|1[0-2])$')
              && d.reason in ['acquisition', 'regular', 'irregular', 'other']
              && d.monthlyAmount is int && d.monthlyAmount >= 0 && d.monthlyAmount <= 99999999
              && validStandard(d.health)
              && validStandard(d.pension);
          }

          allow read: if signedIn() && request.auth.uid in office().memberUids;

          allow create: if signedIn()
            && office().memberRoles[request.auth.uid] == 'admin'
            && validRemuneration(request.resource.data)
            && request.resource.data.createdAt == request.time
            && request.resource.data.updatedAt == request.time;

          allow update: if signedIn()
            && office().memberRoles[request.auth.uid] == 'admin'
            && validRemuneration(request.resource.data)
            && request.resource.data.createdAt == resource.data.createdAt
            && request.resource.data.updatedAt == request.time;

          allow delete: if signedIn() && office().memberRoles[request.auth.uid] == 'admin';
        }
      // ----- 給与の実績（従業員の下。ドキュメントIDは支払った月） -----
        match /payrolls/{paidMonth} {
          function yen(v) {
            return v is int && v >= 0 && v <= 99999999;
          }

          function validPayroll(d) {
            return d.keys().hasOnly(['officeId', 'employeeId', 'paidMonth', 'cash', 'fixed', 'inKind', 'retro',
                                     'days', 'absentDays', 'workMinutes', 'prorated', 'state', 'createdAt', 'updatedAt'])
              && d.keys().hasAll(['officeId', 'employeeId', 'paidMonth', 'cash', 'fixed', 'inKind', 'retro',
                                  'days', 'absentDays', 'workMinutes', 'prorated', 'state', 'createdAt', 'updatedAt'])
              // collectionGroup で読むときのための項目。パスと一致させる
              && d.officeId == officeId
              && d.employeeId == employeeId
              && d.paidMonth == paidMonth
              && paidMonth.matches('^[0-9]{4}-(0[1-9]|1[0-2])$')
              && yen(d.cash) && yen(d.fixed) && yen(d.inKind) && yen(d.retro)
              && d.fixed <= d.cash
              && d.retro <= d.cash + d.inKind
              && d.days is int && d.days >= 0 && d.days <= 31
              && (d.absentDays == null || (d.absentDays is int && d.absentDays >= 0 && d.absentDays <= 31))
              && (d.workMinutes == null || (d.workMinutes is int && d.workMinutes >= 0 && d.workMinutes <= 44640))
              && d.prorated is bool
              && d.state in ['normal', 'suspended', 'furlough'];
          }

          allow read: if signedIn() && request.auth.uid in office().memberUids;

          allow create: if signedIn()
            && office().memberRoles[request.auth.uid] == 'admin'
            && validPayroll(request.resource.data)
            && request.resource.data.createdAt == request.time
            && request.resource.data.updatedAt == request.time;

          allow update: if signedIn()
            && office().memberRoles[request.auth.uid] == 'admin'
            && validPayroll(request.resource.data)
            && request.resource.data.createdAt == resource.data.createdAt
            && request.resource.data.updatedAt == request.time;

          allow delete: if signedIn() && office().memberRoles[request.auth.uid] == 'admin';
        }
        // ----- 定時決定の記録（従業員の下。ドキュメントIDは年） -----
        match /regularDecisions/{year} {
          function std(s) {
            return s is map
              && s.keys().hasOnly(['grade', 'standard']) && s.keys().hasAll(['grade', 'standard'])
              && s.grade is int && s.grade >= 1 && s.grade <= 60
              && s.standard is int && s.standard > 0;
          }

          function optInt(v) {
            return v == null || (v is int && v >= 0);
          }

          function validDecision(d) {
            return d.keys().hasOnly(['officeId', 'employeeId', 'year', 'method', 'usedMonths', 'total', 'average',
                                     'corrected', 'annualAverage', 'monthlyAmount', 'seasonal', 'consent',
                                     'health', 'pension', 'createdAt', 'updatedAt'])
              && d.keys().hasAll(['officeId', 'employeeId', 'year', 'method', 'usedMonths', 'total', 'average',
                                  'corrected', 'annualAverage', 'monthlyAmount', 'seasonal', 'consent',
                                  'health', 'pension', 'createdAt', 'updatedAt'])
              && d.officeId == officeId && d.employeeId == employeeId
              && d.year == year && year.matches('^[0-9]{4}$')
              && d.method in ['normal', 'annual', 'keep']
              && d.usedMonths is list && d.usedMonths.size() <= 12
              && d.total is int && d.total >= 0
              && d.average is int && d.average >= 0
              && optInt(d.corrected) && optInt(d.annualAverage)
              && d.monthlyAmount is int && d.monthlyAmount >= 0 && d.monthlyAmount <= 99999999
              && d.seasonal is bool && d.consent is bool
              // 年間平均は、例年の発生と本人の同意の両方が必要
              && (d.method != 'annual' || (d.seasonal == true && d.consent == true && d.annualAverage != null))
              && std(d.health) && std(d.pension);
          }

          allow read: if signedIn() && request.auth.uid in office().memberUids;

          allow create: if signedIn()
            && office().memberRoles[request.auth.uid] == 'admin'
            && validDecision(request.resource.data)
            && request.resource.data.createdAt == request.time
            && request.resource.data.updatedAt == request.time;

          allow update: if signedIn()
            && office().memberRoles[request.auth.uid] == 'admin'
            && validDecision(request.resource.data)
            && request.resource.data.createdAt == resource.data.createdAt
            && request.resource.data.updatedAt == request.time;

          allow delete: if signedIn() && office().memberRoles[request.auth.uid] == 'admin';
        }
      }

      // ----- 組合健保の料率（事業所の下。ドキュメントIDは適用開始月） -----
      match /kumiaiRates/{rateMonth} {
        function office() {
          return get(/databases/$(database)/documents/offices/$(officeId)).data;
        }

        function isAdmin() {
          return office().memberRoles[request.auth.uid] == 'admin';
        }

        function validKumiaiRate(d) {
          return d.keys().hasOnly(['from', 'health', 'care', 'childSupport', 'createdAt', 'updatedAt'])
            && d.keys().hasAll(['from', 'health', 'care', 'childSupport', 'createdAt', 'updatedAt'])
            && d.from == rateMonth
            && rateMonth.matches('^[0-9]{4}-(0[1-9]|1[0-2])$')
            && validSplit(d.health)
            && validSplit(d.care)
            && validSplit(d.childSupport);
        }

        allow read: if signedIn() && request.auth.uid in office().memberUids;

        // 過去に組合だった期間も直せるよう、「今が組合か」は見ない。
        // 「その月が組合の期間か」はルールでは確かめられない（履歴を1行ずつ見られない）のでアプリで確かめる。
        // 協会けんぽの月に入っても、計算では使われない
        allow create: if signedIn() && isAdmin()
          && validKumiaiRate(request.resource.data)
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time;

        allow update: if signedIn() && isAdmin()
          && validKumiaiRate(request.resource.data)
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.updatedAt == request.time;

        allow delete: if signedIn() && isAdmin();
      }
      // ----- 賞与の支給（事業所の下。1回の支給＝1件。ドキュメントIDは自動） -----
      match /bonusPayments/{paymentId} {
        function office() {
          return get(/databases/$(database)/documents/offices/$(officeId)).data;
        }

        function isAdmin() {
          return office().memberRoles[request.auth.uid] == 'admin';
        }

        // ルールには繰り返しがないので、amounts の1件ずつ（金額が正の整数か等）はアプリで確かめる。
        // ここでは形と件数だけ
        function validBonusPayment(d) {
          return d.keys().hasOnly(['paidDate', 'title', 'amounts', 'createdAt', 'updatedAt'])
            && d.keys().hasAll(['paidDate', 'title', 'amounts', 'createdAt', 'updatedAt'])
            && isDate(d.paidDate)
            && optionalString(d.title, 50)
            && d.amounts is map
            && d.amounts.size() <= 2000;
        }

        allow read: if signedIn() && request.auth.uid in office().memberUids;

        allow create: if signedIn() && isAdmin()
          && validBonusPayment(request.resource.data)
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time;

        allow update: if signedIn() && isAdmin()
          && validBonusPayment(request.resource.data)
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.updatedAt == request.time;

        allow delete: if signedIn() && isAdmin();
      }
    }
  }
}