{
  "hosting": {
    "site": "socialinsurance10168",
    "public": "dist/socialinsurance10168/browser",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "headers": [
      {
        "source": "/i18n/**",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      }
    ]
  },
  "firestore": [
    {
      "database": "socialinsurance-db",
      "rules": "firestore.rules"
    }
  ]
}
